{
  "version": "1",
  "profiles": {
    "typescript": {
      "kind": "npm",
      "packages": [
        "typescript-language-server@4.3.3",
        "typescript@5.3.3"
      ],
      "bin": "typescript-language-server",
      "args": ["--stdio"],
      "file_extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"],
      "root_markers": ["tsconfig.json", "jsconfig.json", "package.json"],
      "tsserver_rel": "node_modules/typescript/lib/tsserver.js"
    },
    "python": {
      "kind": "npm",
      "packages": ["pyright@1.1.411"],
      "bin": "pyright-langserver",
      "args": ["--stdio"],
      "file_extensions": [".py", ".pyi"],
      "root_markers": ["pyrightconfig.json", "pyproject.toml", "setup.py", "requirements.txt"]
    },
    "markdown": {
      "kind": "github_release",
      "repo": "artempyanykh/marksman",
      "tag": "2024-12-18",
      "args": ["server"],
      "file_extensions": [".md", ".mdx"],
      "root_markers": [".git", ".marksman.toml"],
      "assets": {
        "windows/amd64": {
          "name": "marksman.exe",
          "urls": [
            "https://github.com/artempyanykh/marksman/releases/download/2024-12-18/marksman.exe"
          ],
          "sha256": ""
        },
        "linux/amd64": {
          "name": "marksman-linux-x64",
          "urls": [
            "https://github.com/artempyanykh/marksman/releases/download/2024-12-18/marksman-linux-x64"
          ],
          "sha256": ""
        },
        "linux/arm64": {
          "name": "marksman-linux-arm64",
          "urls": [
            "https://github.com/artempyanykh/marksman/releases/download/2024-12-18/marksman-linux-arm64"
          ],
          "sha256": ""
        },
        "darwin/amd64": {
          "name": "marksman-macos",
          "urls": [
            "https://github.com/artempyanykh/marksman/releases/download/2024-12-18/marksman-macos"
          ],
          "sha256": ""
        },
        "darwin/arm64": {
          "name": "marksman-macos",
          "urls": [
            "https://github.com/artempyanykh/marksman/releases/download/2024-12-18/marksman-macos"
          ],
          "sha256": ""
        }
      }
    },
    "go": {
      "kind": "go_install",
      "package": "golang.org/x/tools/gopls@v0.18.1",
      "bin": "gopls",
      "args": ["serve"],
      "file_extensions": [".go"],
      "root_markers": ["go.mod", "go.work"]
    },
    "rust": {
      "kind": "github_release",
      "repo": "rust-lang/rust-analyzer",
      "tag": "2025-01-06",
      "args": [],
      "file_extensions": [".rs"],
      "root_markers": ["Cargo.toml"],
      "assets": {
        "windows/amd64": {
          "name": "rust-analyzer-x86_64-pc-windows-msvc.zip",
          "urls": [
            "https://github.com/rust-lang/rust-analyzer/releases/download/2025-01-06/rust-analyzer-x86_64-pc-windows-msvc.zip"
          ],
          "sha256": "",
          "extract_bin": "rust-analyzer.exe"
        },
        "linux/amd64": {
          "name": "rust-analyzer-x86_64-unknown-linux-gnu.gz",
          "urls": [
            "https://github.com/rust-lang/rust-analyzer/releases/download/2025-01-06/rust-analyzer-x86_64-unknown-linux-gnu.gz"
          ],
          "sha256": "",
          "extract_bin": "rust-analyzer"
        },
        "darwin/arm64": {
          "name": "rust-analyzer-aarch64-apple-darwin.gz",
          "urls": [
            "https://github.com/rust-lang/rust-analyzer/releases/download/2025-01-06/rust-analyzer-aarch64-apple-darwin.gz"
          ],
          "sha256": "",
          "extract_bin": "rust-analyzer"
        },
        "darwin/amd64": {
          "name": "rust-analyzer-x86_64-apple-darwin.gz",
          "urls": [
            "https://github.com/rust-lang/rust-analyzer/releases/download/2025-01-06/rust-analyzer-x86_64-apple-darwin.gz"
          ],
          "sha256": "",
          "extract_bin": "rust-analyzer"
        }
      }
    },
    "html": {
      "kind": "npm",
      "packages": ["vscode-langservers-extracted@4.10.0"],
      "bin": "vscode-html-language-server",
      "args": ["--stdio"],
      "file_extensions": [".html", ".htm"],
      "root_markers": ["package.json", ".git"]
    },
    "css": {
      "kind": "npm",
      "packages": ["vscode-langservers-extracted@4.10.0"],
      "bin": "vscode-css-language-server",
      "args": ["--stdio"],
      "file_extensions": [".css", ".scss"],
      "root_markers": ["package.json", ".git"],
      "shared_install": "html"
    },
    "json": {
      "kind": "npm",
      "packages": ["vscode-langservers-extracted@4.10.0"],
      "bin": "vscode-json-language-server",
      "args": ["--stdio"],
      "file_extensions": [".json", ".jsonc"],
      "root_markers": ["package.json", ".git"],
      "shared_install": "html"
    },
    "xml": {
      "kind": "github_release",
      "repo": "redhat-developer/vscode-xml",
      "tag": "0.27.1",
      "args": ["-Djava.import.generatesMetadataFilesAtProjectRoot=false"],
      "file_extensions": [".xml"],
      "root_markers": [".git"],
      "disabled": true,
      "disabled_reason": "lemminx packaging TBD"
    },
    "csharp": {
      "kind": "dotnet_tool",
      "package": "csharp-ls",
      "version": "0.16.0",
      "bin": "csharp-ls",
      "args": [],
      "file_extensions": [".cs"],
      "root_markers": [".sln", ".csproj"],
      "disabled": true,
      "disabled_reason": "dotnet tool packaging TBD"
    },
    "cpp": {
      "kind": "github_release",
      "repo": "clangd/clangd",
      "tag": "18.1.3",
      "args": [],
      "file_extensions": [".c", ".h", ".cpp", ".cc", ".cxx", ".hpp", ".hxx", ".hh"],
      "root_markers": ["compile_commands.json", "CMakeLists.txt", ".clangd"],
      "disabled": true,
      "disabled_reason": "clangd asset pins TBD"
    },
    "gdscript": {
      "kind": "none",
      "file_extensions": [".gd"],
      "root_markers": ["project.godot"],
      "disabled": true,
      "disabled_reason": "Godot LS packaging TBD"
    },
    "csv": {
      "kind": "none",
      "file_extensions": [".csv", ".tsv"],
      "root_markers": [".git"],
      "disabled": true,
      "disabled_reason": "no pin-able CSV LS yet"
    }
  }
}
