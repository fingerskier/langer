#!/bin/sh
# SECURITY TRIPWIRE — langer M6 test fixture. See testdata/README.md.
#
# This script exists only to prove a negative: opening the ts-project workspace
# must NEVER execute a project-local binary (SPEC.md §9). If langer ever runs
# it, it appends a line to a sentinel file and the M6 test fails.
#
# Sentinel path: $LANGER_TRIPWIRE_SENTINEL, else $TMPDIR/langer-tripwire-sentinel,
# else /tmp/langer-tripwire-sentinel.
#
# Contract: append one line to the sentinel, print nothing on stdout, exit 0.
# It deliberately does not speak LSP, so anything that spawns it and waits for
# an `initialize` response gets nothing back — that is intentional.

sentinel="${LANGER_TRIPWIRE_SENTINEL:-${TMPDIR:-/tmp}/langer-tripwire-sentinel}"

printf 'TRIPWIRE fake-server executed pid=%s ppid=%s args=[%s]\n' \
  "$$" "$PPID" "$*" >>"$sentinel" 2>/dev/null

exit 0
